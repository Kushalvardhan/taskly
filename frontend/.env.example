# Base URL the browser uses for API calls.
# "/api" goes through the Vite dev proxy (see vite.config.ts).
VITE_API_BASE_URL=/api

# Backend the dev proxy forwards /api requests to (dev server only).
API_PROXY_TARGET=http://localhost:8080

# Production: either serve the frontend and backend behind one reverse proxy
# and keep VITE_API_BASE_URL=/api, or point it at the deployed backend, e.g.
# VITE_API_BASE_URL=https://api.example.com/api
